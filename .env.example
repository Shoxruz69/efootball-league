# =======================================================
# eFootball Telegram League & Mini App Production Config
# =======================================================

# Server port (Render automatically provides PORT in production)
PORT=3000

# Telegram Bot Token (Obtained from @BotFather in Telegram)
# Example: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=

# Admin Telegram IDs (Comma-separated Telegram numerical IDs)
# Example: 123456789 or 123456789,987654321
ADMIN_TELEGRAM_IDS=123456789

# Web Admin Password (Used to log into the /admin dashboard on web/laptop)
ADMIN_PASSWORD=efootball_admin_2026

# Telegram Mini App URL
# On Render: https://<your-service-name>.onrender.com
# If left empty, server uses RENDER_EXTERNAL_URL or launches local HTTPS tunnel
MINI_APP_URL=

# Gemini Vision API Key (Optional: for OCR screenshot score recognition)
# Free from https://aistudio.google.com
GEMINI_API_KEY=

# Ngrok Authtoken (Optional: only needed if using ngrok tunnels locally)
NGROK_AUTHTOKEN=
